# Admin credentials (production에서는 반드시 변경하세요)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# Database
DATABASE_URL=your_database_url_here

# Email (현재 비활성화됨)
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# ADMIN_EMAIL=admin@example.com
# NAVER_EMAIL=your_naver_email_here
# NAVER_PASSWORD=your_naver_password_here

# Session Secret (production에서는 반드시 변경하세요)
SESSION_SECRET=change_me_long_random_string

# Supabase (필수 - 로컬 개발 및 배포용)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Local development only: set to true in your own .env to enable the DEV test-login button.
# Never set this in Cloudflare Pages settings.
DEV_LOGIN=

# Web Push (VAPID). Generate a pair once (see design/notifications.md) and set the same values
# as Cloudflare Pages secrets for production. Never reuse the local pair in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://www.facebook.com/meatmall.mahnii.delguur
