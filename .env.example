# Admin credentials (production에서는 반드시 변경하세요)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# Cloudflare: production DB and image files use the DB (D1) and BUCKET (R2) bindings in wrangler.toml.
# For drizzle-kit remote schema operations only:
CLOUDFLARE_ACCOUNT_ID=61e0515df3f53839938d8c530946e375
CLOUDFLARE_DATABASE_ID=aab20aff-ba88-4444-b9da-39ce2ff6dbdc
CLOUDFLARE_API_TOKEN=

# Email (현재 비활성화됨)
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# ADMIN_EMAIL=admin@example.com
# NAVER_EMAIL=your_naver_email_here
# NAVER_PASSWORD=your_naver_password_here

# Session Secret (production에서는 반드시 변경하세요)
SESSION_SECRET=change_me_long_random_string

# Optional Google sign-in. Register /api/auth/google/callback on the final site origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BASE_URL=

# Local development only: set to true in your own .env to enable the DEV test-login button.
# Never set this in Cloudflare Pages settings.
DEV_LOGIN=

# Web Push (VAPID). Generate a pair once (see design/notifications.md) and set the same values
# as Cloudflare Pages secrets for production. Never reuse the local pair in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://www.facebook.com/meatmall.mahnii.delguur
